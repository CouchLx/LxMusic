# 复制此文件为 keystore.properties 并填写你的真实配置
# keystore.properties 已被 .gitignore 排除，不会提交到仓库

# 酷狗 API 服务器地址（自建后端）
LX_SERVER_URL=http://your-server:3000/

# 设置页"管理员验证"密码（查看默认服务器地址用）
LX_ADMIN_PASSWORD=

# 应用更新 version.json 地址（可选，留空则用 GitHub 镜像）
LX_UPDATE_VERSION_URL=

# Release 签名（可选，不配置则 APK 未签名）
STORE_FILE=release.jks
STORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
